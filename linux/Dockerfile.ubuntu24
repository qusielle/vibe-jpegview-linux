# syntax=docker/dockerfile:1

FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage
ARG APPIMAGETOOL_SHA256=

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    g++ make cmake ninja-build pkg-config curl ca-certificates file patchelf nasm \
    libsdl2-2.0-0 libpango1.0-dev libfontconfig1-dev fonts-dejavu-core \
    libjpeg-dev libpng-dev libjpeg-turbo-progs \
    libgif-dev libtiff-dev libwebp-dev libheif-dev libraw-dev libjxr-dev \
    libavif-dev libjxl-dev libaom-dev libde265-dev libx265-dev \
    libbrotli-dev liblcms2-dev xclip wl-clipboard \
 && curl --fail --location --retry 3 "$APPIMAGETOOL_URL" --output /usr/local/bin/appimagetool \
 && chmod 755 /usr/local/bin/appimagetool \
 && if [ -n "$APPIMAGETOOL_SHA256" ]; then echo "$APPIMAGETOOL_SHA256  /usr/local/bin/appimagetool" | sha256sum --check; fi \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src
COPY linux/docker-build.sh /usr/local/bin/jpegview-docker-build
RUN chmod 755 /usr/local/bin/jpegview-docker-build

RUN make -C linux -j"$(nproc)" all test

VOLUME ["/out"]
ENTRYPOINT ["/usr/local/bin/jpegview-docker-build"]
CMD ["appimage"]
