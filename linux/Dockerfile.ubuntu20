# syntax=docker/dockerfile:1

FROM ubuntu:20.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage
ARG APPIMAGETOOL_SHA256=

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    g++ make cmake ninja-build pkg-config curl ca-certificates file patchelf nasm \
    libsdl2-2.0-0 libpango1.0-dev libfontconfig1-dev fonts-dejavu-core \
    libjpeg-dev libpng-dev libjpeg-turbo-progs \
    libgif-dev libtiff-dev libwebp-dev libwebp6 libheif-dev libraw-dev libjxr-dev \
    libaom-dev libde265-dev libx265-dev libbrotli-dev liblcms2-dev \
    xclip wl-clipboard \
 && curl --fail --location --retry 3 "$APPIMAGETOOL_URL" --output /usr/local/bin/appimagetool \
 && chmod 755 /usr/local/bin/appimagetool \
 && if [ -n "$APPIMAGETOOL_SHA256" ]; then echo "$APPIMAGETOOL_SHA256  /usr/local/bin/appimagetool" | sha256sum --check; fi \
 && rm -rf /var/lib/apt/lists/*

# Focal has the native GIF/TIFF/WebP/HEIF/RAW/JPEG-XR development packages,
# but JPEG XL and AVIF development packages were introduced later. Build the
# two missing codec dependency chains in independent BuildKit stages. Since
# neither chain depends on the other, BuildKit can run them concurrently.

FROM base AS highway-jxl

ARG HIGHWAY_VERSION=1.0.7
ARG LIBJXL_VERSION=0.7.0
ARG LIBJXL_SKCMS_VERSION=64374756e03700d649f897dbd98c95e78c30c7da
RUN mkdir -p /tmp/jpegview-codecs \
 && curl --fail --location --retry 3 "https://github.com/google/highway/archive/refs/tags/${HIGHWAY_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/highway.tar.gz \
 && tar -xzf /tmp/jpegview-codecs/highway.tar.gz -C /tmp/jpegview-codecs \
 && cmake -S "/tmp/jpegview-codecs/highway-${HIGHWAY_VERSION}" -B /tmp/jpegview-codecs/highway-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DHWY_ENABLE_TESTS=OFF -DHWY_ENABLE_CONTRIB=OFF \
 && cmake --build /tmp/jpegview-codecs/highway-build --parallel \
 && cmake --install /tmp/jpegview-codecs/highway-build

RUN curl --fail --location --retry 3 "https://github.com/libjxl/libjxl/archive/refs/tags/v${LIBJXL_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/libjxl.tar.gz \
 && tar -xzf /tmp/jpegview-codecs/libjxl.tar.gz -C /tmp/jpegview-codecs \
 && mkdir -p "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}/third_party/skcms" \
 && curl --fail --location --retry 3 \
    "https://skia.googlesource.com/skcms/+archive/${LIBJXL_SKCMS_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/skcms.tar.gz \
 && tar -xzf /tmp/jpegview-codecs/skcms.tar.gz \
    -C "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}/third_party/skcms" \
 && cmake -S "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}" -B /tmp/jpegview-codecs/libjxl-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
    -DJPEGXL_ENABLE_TOOLS=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF -DJPEGXL_ENABLE_BENCHMARK=OFF \
    -DJPEGXL_ENABLE_JNI=OFF -DJPEGXL_ENABLE_SKCMS=ON -DJPEGXL_ENABLE_SJPEG=OFF \
    -DJPEGXL_ENABLE_OPENEXR=OFF -DJPEGXL_ENABLE_DOXYGEN=OFF -DJPEGXL_ENABLE_MANPAGES=OFF \
    -DJPEGXL_FORCE_SYSTEM_BROTLI=ON -DJPEGXL_FORCE_SYSTEM_LCMS2=ON \
    -DJPEGXL_FORCE_SYSTEM_HWY=ON \
 && cmake --build /tmp/jpegview-codecs/libjxl-build --parallel \
 && cmake --install /tmp/jpegview-codecs/libjxl-build

FROM base AS aom-avif

ARG AOM_VERSION=3.2.0
ARG LIBAVIF_VERSION=0.9.3

RUN mkdir -p "/tmp/jpegview-codecs/aom-${AOM_VERSION}" \
 && curl --fail --location --retry 3 \
    "https://aomedia.googlesource.com/aom/+archive/v${AOM_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/aom.tar.gz \
 && tar -xzf /tmp/jpegview-codecs/aom.tar.gz \
    -C "/tmp/jpegview-codecs/aom-${AOM_VERSION}" \
 && cmake -S "/tmp/jpegview-codecs/aom-${AOM_VERSION}" -B /tmp/jpegview-codecs/aom-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
    -DENABLE_TESTS=OFF -DENABLE_TOOLS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_DOCS=OFF \
 && cmake --build /tmp/jpegview-codecs/aom-build --parallel \
 && cmake --install /tmp/jpegview-codecs/aom-build

RUN curl --fail --location --retry 3 "https://github.com/AOMediaCodec/libavif/archive/refs/tags/v${LIBAVIF_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/libavif.tar.gz \
 && tar -xzf /tmp/jpegview-codecs/libavif.tar.gz -C /tmp/jpegview-codecs \
 && cmake -S "/tmp/jpegview-codecs/libavif-${LIBAVIF_VERSION}" -B /tmp/jpegview-codecs/libavif-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DAVIF_CODEC_AOM=SYSTEM \
    -DAOM_INCLUDE_DIR=/usr/local/include -DAOM_LIBRARY=/usr/local/lib/libaom.so \
    -DAVIF_BUILD_APPS=OFF -DAVIF_BUILD_TESTS=OFF \
 && cmake --build /tmp/jpegview-codecs/libavif-build --parallel \
 && cmake --install /tmp/jpegview-codecs/libavif-build \
 && rm -rf /tmp/jpegview-codecs

FROM base

# These independent copies keep the codec branches parallel during the
# BuildKit solve while producing one final image for the application build.
COPY --from=highway-jxl /usr/local/ /usr/local/
COPY --from=aom-avif /usr/local/ /usr/local/
RUN ldconfig

WORKDIR /src
COPY . /src
COPY linux/docker-build.sh /usr/local/bin/jpegview-docker-build
RUN chmod 755 /usr/local/bin/jpegview-docker-build

# The viewer and core-test executable are independent link targets. Build
# both concurrently, then run the tests as soon as their target is ready.
RUN make -C linux -j"$(nproc)" all test

VOLUME ["/out"]
ENTRYPOINT ["/usr/local/bin/jpegview-docker-build"]
CMD ["appimage"]
