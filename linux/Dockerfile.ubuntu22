# syntax=docker/dockerfile:1

FROM ubuntu:22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    g++ make cmake ninja-build pkg-config curl ca-certificates file patchelf nasm git \
    appstream desktop-file-utils xvfb x11-utils \
    libsdl2-2.0-0 libpango1.0-dev libfontconfig1-dev fonts-dejavu-core zsync \
    libjpeg-dev libpng-dev libjpeg-turbo-progs libzip-dev libarchive-dev zip \
    libgif-dev libtiff-dev libwebp-dev libheif-dev libraw-dev libjxr-dev \
    libavif-dev libaom-dev libde265-dev libx265-dev libbrotli-dev liblcms2-dev librsvg2-dev libxml2-dev \
    xclip wl-clipboard \
 && rm -rf /var/lib/apt/lists/*

# Jammy provides AVIF development files but not JPEG XL. Build only the
# missing JPEG XL dependency chain; the distro packages provide the rest.
FROM base AS highway-jxl

ARG HIGHWAY_VERSION=1.0.7
ARG HIGHWAY_SHA256=5434488108186c170a5e2fca5e3c9b6ef59a1caa4d520b008a9b8be6b8abe6c5
ARG LIBJXL_VERSION=0.7.0
ARG LIBJXL_SHA256=3114bba1fabb36f6f4adc2632717209aa6f84077bc4e93b420e0d63fa0455c5e
ARG LIBJXL_SKCMS_VERSION=64374756e03700d649f897dbd98c95e78c30c7da
ARG LIBJXL_SKCMS_URL=https://distfiles.macports.org/libjxl/skcms-${LIBJXL_SKCMS_VERSION}.tar.gz
ARG LIBJXL_SKCMS_SHA256=aabd4bae8b741c9bdc8b31bec95df3a3344b77c7d17bf9d25befb401f4971d18
RUN mkdir -p /tmp/jpegview-codecs \
 && curl --fail --location --retry 3 "https://github.com/google/highway/archive/refs/tags/${HIGHWAY_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/highway.tar.gz \
 && printf '%s  %s\n' "$HIGHWAY_SHA256" /tmp/jpegview-codecs/highway.tar.gz | sha256sum --check \
 && tar -xzf /tmp/jpegview-codecs/highway.tar.gz -C /tmp/jpegview-codecs \
 && cmake -S "/tmp/jpegview-codecs/highway-${HIGHWAY_VERSION}" -B /tmp/jpegview-codecs/highway-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DHWY_ENABLE_TESTS=OFF -DHWY_ENABLE_CONTRIB=OFF \
 && cmake --build /tmp/jpegview-codecs/highway-build --parallel \
 && cmake --install /tmp/jpegview-codecs/highway-build

RUN curl --fail --location --retry 3 "https://github.com/libjxl/libjxl/archive/refs/tags/v${LIBJXL_VERSION}.tar.gz" \
    --output /tmp/jpegview-codecs/libjxl.tar.gz \
 && printf '%s  %s\n' "$LIBJXL_SHA256" /tmp/jpegview-codecs/libjxl.tar.gz | sha256sum --check \
 && tar -xzf /tmp/jpegview-codecs/libjxl.tar.gz -C /tmp/jpegview-codecs \
 && mkdir -p "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}/third_party/skcms" \
 && curl --fail --location --retry 8 --retry-max-time 90 \
    "$LIBJXL_SKCMS_URL" \
    --output /tmp/jpegview-codecs/skcms.tar.gz \
 && printf '%s  %s\n' "$LIBJXL_SKCMS_SHA256" /tmp/jpegview-codecs/skcms.tar.gz | sha256sum --check \
 && tar -xzf /tmp/jpegview-codecs/skcms.tar.gz \
    -C "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}/third_party/skcms" \
 && cmake -S "/tmp/jpegview-codecs/libjxl-${LIBJXL_VERSION}" -B /tmp/jpegview-codecs/libjxl-build -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
    -DJPEGXL_ENABLE_TOOLS=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF -DJPEGXL_ENABLE_BENCHMARK=OFF \
    -DJPEGXL_ENABLE_JNI=OFF -DJPEGXL_ENABLE_SKCMS=ON -DJPEGXL_ENABLE_SJPEG=OFF \
    -DJPEGXL_ENABLE_OPENEXR=OFF -DJPEGXL_ENABLE_DOXYGEN=OFF -DJPEGXL_ENABLE_MANPAGES=OFF \
    -DJPEGXL_FORCE_SYSTEM_BROTLI=ON -DJPEGXL_FORCE_SYSTEM_LCMS2=ON \
    -DJPEGXL_FORCE_SYSTEM_HWY=ON \
 && cmake --build /tmp/jpegview-codecs/libjxl-build --parallel \
 && cmake --install /tmp/jpegview-codecs/libjxl-build \
 && rm -rf /tmp/jpegview-codecs

FROM base

COPY --from=highway-jxl /usr/local/ /usr/local/
RUN ldconfig

COPY linux/fetch-7zip-source.sh linux/install-rust-toolchain.sh linux/fetch-rars-source.sh linux/retry-command.sh /tmp/jpegview-build-scripts/
RUN sh /tmp/jpegview-build-scripts/fetch-7zip-source.sh /opt/jpegview/7zip-24.09
ENV SEVENZIP_SOURCE_ROOT=/opt/jpegview/7zip-24.09 \
	SEVENZIP_SOURCE_ARCHIVE=/opt/jpegview/7zip-24.09-source.tar.gz
RUN sh /tmp/jpegview-build-scripts/install-rust-toolchain.sh /opt/jpegview/rust-1.89 \
 && sh /tmp/jpegview-build-scripts/fetch-rars-source.sh /opt/jpegview/rars-afc60e4
ENV RUSTUP_HOME=/opt/jpegview/rust-1.89/rustup \
	CARGO_HOME=/opt/jpegview/rust-1.89/cargo \
	PATH="/opt/jpegview/rust-1.89/cargo/bin:${PATH}" \
	RAR_BACKEND_ROOT=/src/linux/rar_backend \
	RAR_SOURCE_ARCHIVE=/opt/jpegview/rars-afc60e4-source.tar.gz \
	RAR_LICENSE_FILE=/opt/jpegview/rars-afc60e4-COPYING

ARG APPIMAGETOOL_VERSION=1.9.1
ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-x86_64.AppImage
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG APPIMAGETOOL_RUNTIME_VERSION=20251108
ARG APPIMAGETOOL_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/${APPIMAGETOOL_RUNTIME_VERSION}/runtime-x86_64
ARG APPIMAGETOOL_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
RUN curl --fail --location --retry 3 "$APPIMAGETOOL_URL" --output /usr/local/bin/appimagetool \
 && printf '%s  %s\n' "$APPIMAGETOOL_SHA256" /usr/local/bin/appimagetool | sha256sum --check \
 && chmod 755 /usr/local/bin/appimagetool \
 && mkdir -p /usr/local/lib/appimagetool \
 && curl --fail --location --retry 3 "$APPIMAGETOOL_RUNTIME_URL" \
    --output /usr/local/lib/appimagetool/runtime-x86_64 \
 && printf '%s  %s\n' "$APPIMAGETOOL_RUNTIME_SHA256" /usr/local/lib/appimagetool/runtime-x86_64 | sha256sum --check \
 && chmod 755 /usr/local/lib/appimagetool/runtime-x86_64
ENV APPIMAGETOOL_RUNTIME_FILE=/usr/local/lib/appimagetool/runtime-x86_64

WORKDIR /src
COPY . /src
COPY linux/docker-build.sh /usr/local/bin/jpegview-docker-build
RUN chmod 755 /usr/local/bin/jpegview-docker-build

RUN make -C linux -j"$(nproc)" all test

VOLUME ["/out"]
ENTRYPOINT ["/usr/local/bin/jpegview-docker-build"]
CMD ["appimage"]
